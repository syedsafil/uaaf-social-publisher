# Environment Configuration Template
# UAAF Social Publisher

# ── Meta Graph API (Instagram Reels & Facebook Reels) ──
META_ACCESS_TOKEN="your_meta_system_user_token_here"
META_FB_PAGE_ID="your_facebook_page_id_here"
META_IG_BUSINESS_ACCOUNT_ID="your_instagram_business_account_id_here"

# ── TikTok Content Posting API v2 ──
TIKTOK_CLIENT_KEY="your_tiktok_client_key_here"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret_here"
TIKTOK_ACCESS_TOKEN="your_tiktok_access_token_here"
TIKTOK_REFRESH_TOKEN="your_tiktok_refresh_token_here"

# ── YouTube Data API v3 ──
YOUTUBE_CLIENT_ID="your_youtube_client_id_here"
YOUTUBE_CLIENT_SECRET="your_youtube_client_secret_here"
YOUTUBE_REFRESH_TOKEN="your_youtube_refresh_token_here"
YOUTUBE_PRIVACY_STATUS="private"

# ── X.com / Twitter Media Upload API v2 ──
X_API_KEY="your_x_api_key_here"
X_API_SECRET="your_x_api_secret_here"
X_ACCESS_TOKEN="your_x_access_token_here"
X_ACCESS_TOKEN_SECRET="your_x_access_secret_here"

# Optional legacy aliases for Twitter
TWITTER_API_KEY="your_x_api_key_here"
TWITTER_API_SECRET="your_x_api_secret_here"
TWITTER_ACCESS_TOKEN="your_x_access_token_here"
TWITTER_ACCESS_SECRET="your_x_access_secret_here"

# ── Optional: Email Approver (Resend API) ──
RESEND_API_KEY="your_resend_api_key_here"
CHAIRMAN_EMAIL="your_email@example.com"
